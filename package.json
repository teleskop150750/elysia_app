{
  "name": "app",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "kysely": "kysely-codegen --out-file ./src/db/db.d.ts",
    "build": "bunx --bun vite build",
    "dev": "bunx --bun vite dev",
    "dev:bun": "bun run --watch src/index.ts",
    "start:srvx": "srvx --prod .output/",
    "start:node": "NODE_ENV=production node --env-file=.env .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:up": "drizzle-kit up",
    "db:studio": "drizzle-kit studio",
    "eslint": "eslint",
    "eslint:fix": "eslint --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.15",
    "drizzle-orm": "1.0.0-beta.10-42c284e",
    "elysia": "latest",
    "h3": "^2.0.1-rc.20",
    "kysely": "^0.28.16",
    "kysely-bun-sql": "^0.2.0",
    "nitro": "^3.0.260415-beta",
    "pg": "^8.20.0",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@types/bun": "^1.3.13",
    "drizzle-kit": "1.0.0-beta.10-42c284e",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.8.3",
    "srvx": "^0.11.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
