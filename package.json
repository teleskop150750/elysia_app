{
  "name": "app",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "kysely": "kysely-codegen --out-file ./src/db/db.d.ts",
    "build": "bunx --bun vite build",
    "dev": "bunx --bun vite dev",
    "dev:bun": "bun run --watch src/index.ts",
    "start:srvx": "srvx --prod .output/",
    "start:node": "NODE_ENV=production node --env-file=.env .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:up": "drizzle-kit up",
    "db:studio": "drizzle-kit studio",
    "eslint": "eslint",
    "eslint:fix": "eslint --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.13",
    "@valibot/to-json-schema": "^1.6.0",
    "drizzle-orm": "1.0.0-beta.10-42c284e",
    "elysia": "latest",
    "h3": "^2.0.1-rc.7",
    "kysely": "^0.28.9",
    "kysely-bun-sql": "^0.2.0",
    "nitro": "^3.0.1-alpha.1",
    "pg": "^8.16.3",
    "uuid": "^13.0.0",
    "valibot": "^1.3.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@types/bun": "^1.3.5",
    "drizzle-kit": "1.0.0-beta.10-42c284e",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "kysely-codegen": "^0.19.0",
    "prettier": "^3.7.4",
    "srvx": "^0.10.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0-beta.7"
  }
}
